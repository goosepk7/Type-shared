--!strict
-- Texture table for Effects: one name -> uploaded Roblox image id, with a safe built-in fallback.
--
-- The PNGs are generated by assets/textures/generate.py and uploaded (assetType Image) by
-- assets/textures/upload.py, which rewrites AssetIds.luau. Until a name has an id (or if a game wants to run
-- without them), the fallback is a texture that ships with every Roblox client (rbxasset://textures/particles/*),
-- and flipbook layouts drop to None because the fallbacks are single images.
-- Decal-only textures (ground marks) have no built-in equivalent: their fallback is "" and the runtime swaps
-- to a part-based look (e.g. a soft dark disc for the meteor shadow).

local AssetIds = require(script.Parent.AssetIds) :: { [string]: string }

local Assets = {}

export type TextureInfo = {
	file: string, -- assets/textures/<file>.png
	fallback: string, -- built-in content id or "" (no fallback)
	layout: string?, -- Enum.ParticleFlipbookLayout name when the uploaded sheet is a flipbook
	use: string, -- what it is for (docs)
}

local BUILTIN = {
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	sparkles = "rbxasset://textures/particles/sparkles_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	core = "rbxasset://textures/particles/explosion01_core_main.dds",
	shockwave = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
}

local TEXTURES: { [string]: TextureInfo } = {
	glow = { file = "glow", fallback = BUILTIN.glow, use = "soft round glow (cores, flares, motes)" },
	glow_core = { file = "glow_core", fallback = BUILTIN.glow, use = "hot bright core with soft falloff" },
	spark = { file = "spark", fallback = BUILTIN.sparks, use = "velocity-aligned spark streak" },
	star = { file = "star", fallback = BUILTIN.sparkles, use = "4+4 point twinkle" },
	burst = { file = "burst", fallback = BUILTIN.core, use = "radial impact flash" },
	ring = { file = "ring", fallback = BUILTIN.shockwave, use = "shockwave ring (flat particles)" },
	shadow = { file = "shadow", fallback = "", use = "soft ground shadow decal (meteor/lob landing)" },
	scorch = { file = "scorch", fallback = "", use = "burnt ground decal" },
	crack = { file = "crack", fallback = "", use = "ground crack decal (quakes, meteor craters)" },
	frost = { file = "frost", fallback = "", use = "frost ground decal (freeze, permafrost)" },
	rune_circle = { file = "rune_circle", fallback = "", use = "magic circle decal (summon, arcane zones)" },
	runes_4x4 = { file = "runes_4x4", fallback = BUILTIN.sparkles, layout = "Grid4x4", use = "16 glyphs (Random flipbook)" },
	raindrop = { file = "raindrop", fallback = BUILTIN.sparks, use = "rain streak" },
	bubble = { file = "bubble", fallback = BUILTIN.glow, use = "bubble with rim highlight" },
	swirl = { file = "swirl", fallback = BUILTIN.vortex, use = "curved wind streak" },
	snowflake = { file = "snowflake", fallback = BUILTIN.sparkles, use = "snowflake" },
	shard = { file = "shard", fallback = BUILTIN.sparkles, use = "crystal shard" },
	leaf = { file = "leaf", fallback = BUILTIN.sparkles, use = "leaf" },
	petal = { file = "petal", fallback = BUILTIN.sparkles, use = "flower petal" },
	heart = { file = "heart", fallback = BUILTIN.sparkles, use = "charm heart" },
	arrow_down = { file = "arrow_down", fallback = BUILTIN.sparkles, use = "weaken arrow" },
	plus = { file = "plus", fallback = BUILTIN.sparkles, use = "regen plus" },
	music_note = { file = "music_note", fallback = BUILTIN.sparkles, use = "music note (mood/material)" },
	zzz = { file = "zzz", fallback = BUILTIN.sparkles, use = "sleepy Zzz" },
	question = { file = "question", fallback = BUILTIN.sparkles, use = "confused question mark" },
	pixel = { file = "pixel", fallback = BUILTIN.sparkles, use = "square bit (glitch, confetti, sprinkles)" },
	beam_lightning = { file = "beam_lightning", fallback = "", use = "tileable jagged bolt (Beam)" },
	beam_energy = { file = "beam_energy", fallback = "", use = "tileable energy band (Beam/Trail)" },
	smoke_4x4 = { file = "smoke_4x4", fallback = BUILTIN.smoke, layout = "Grid4x4", use = "smoke puff flipbook" },
	flame_4x4 = { file = "flame_4x4", fallback = BUILTIN.fire, layout = "Grid4x4", use = "flame tongue flipbook" },
}
Assets.Textures = TEXTURES
Assets.Builtin = BUILTIN

local override: { [string]: string } = {}

--- Content id for a texture name, its flipbook layout name ("None" when not a flipbook or not uploaded),
--- and whether it is the real uploaded asset.
function Assets.texture(name: string, allowFlipbook: boolean?): (string, string, boolean)
	local info = TEXTURES[name]
	if info == nil then
		return BUILTIN.glow, "None", false
	end
	local id = override[name] or AssetIds[name]
	if id and id ~= "" then
		local layout = if info.layout and allowFlipbook ~= false then info.layout else "None"
		if info.layout and layout == "None" then
			-- flipbooks disabled (low quality / memory): uploaded sheet would show all frames, use fallback
			return info.fallback, "None", false
		end
		return id, layout, true
	end
	return info.fallback, "None", false
end

function Assets.has(name: string): boolean
	return TEXTURES[name] ~= nil
end

function Assets.uploaded(name: string): boolean
	local id = override[name] or AssetIds[name]
	return id ~= nil and id ~= ""
end

--- Games may point names at their own assets (e.g. a studio-made flipbook) at startup.
function Assets.set(name: string, contentId: string)
	assert(TEXTURES[name], "Assets.set: unknown texture " .. name)
	override[name] = contentId
end

return Assets
