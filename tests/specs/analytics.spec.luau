-- Analytics: rates, top words, rollup flush (counters add-merge, ordered top words), no raw input stored.
return function(t)
	local Mocks = t.load("tests/mocks/services")

	t.test("rates, rollup and top words", function()
		local m = Mocks.setup(t)
		local Data = t.load("src/Server/Data")
		local A = t.load("src/Server/Analytics")
		Data._reset()
		A._reset()
		A._setGame("Wizard")
		Data.useStore(m.LocalStore.new("players"))
		local function r(id, source)
			return { id = id, source = source or "Library", element = "Fire", category = "Creature", input = "SECRET raw " .. id }
		end
		A.word(nil, r("dragon"), { latencyMs = 10 })
		A.word(nil, r("dragon"), { corrected = true, latencyMs = 30 })
		A.word(nil, r("zorp", "AI"), { ai = true })
		A.word(nil, r("glitter blob", "Fallback"), { fallback = true, normalized = "flibber jab", reason = "Ok" })
		A.word(nil, r("glitter blob", "Fallback"), { fallback = true, normalized = "call 555 1234", reason = "Ok" })
		A.word(nil, r("glitter blob", "Fallback"), { fallback = true, normalized = "rude thing", reason = "Blocked" })
		A.word(nil, r("dragon", "Cache"), { cacheHit = true })
		A.aiCost(0.002, 300, 120, 800)
		A.correctionShown(nil)
		A.correctionShown(nil)
		A.correctionAccepted(nil, true)
		local snap = A.snapshot()
		t.eq(snap.counters.words, 7)
		t.eq(snap.rates.fallbackRate, 3 / 7)
		t.eq(snap.rates.cacheHitRate, 1 / 7)
		t.eq(snap.counters.aiCalls, 1)
		t.eq(snap.rates.meanAiLatencyMs, 800)
		t.eq(#snap.unknown, 1, "digits and refused input are never logged")
		t.eq(snap.unknown[1].word, "flibber jab")
		t.eq(snap.rates.correctionSuccessRate, 0.5)
		t.eq(snap.rates.meanLatencyMs, 20)
		t.eq(snap.topWords[1].word, "dragon")
		t.ok(A.flush(), "flush ok")
		local day = A.daily()
		t.eq(day.counters.words, 7)
		t.eq(day.counters.aiCalls, 1)
		t.eq(A.unknownPhrases(5)[1].word, "flibber jab")
		t.eq(day.counters.tokensIn, 300)
		A.word(nil, r("dragon"))
		A.flush()
		t.eq(A.daily().counters.words, 8, "add-merged")
		t.eq(#A.history(3), 1)
		local top = A.topWords(5)
		t.eq(top[1].word, "dragon")
		t.eq(top[1].count, 4)
		for _, row in top do
			t.ok(not string.find(row.word, "SECRET"), "raw input never stored")
			t.ok(row.word ~= "glitter blob", "fallbacks not counted as words")
		end
	end)
end
