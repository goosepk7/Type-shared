return function(t)
	local N = t.load("src/Shared/Normalizer")

	t.test("lowercase, trim, collapse spaces, strip punctuation and emoji", function()
		t.eq(N.normalize("  Giant   SHARK!!! "), "giant shark")
		t.eq(N.normalize("fire🔥dragon"), "fire dragon")
		t.eq(N.normalize("🔥🔥🔥"), "")
		t.eq(N.normalize("¿¡Dragón!?"), "dragon")
		t.eq(N.normalize("ＤＲＡＧＯＮ"), "dragon")
		t.eq(N.normalize("crème brûlée"), "creme brulee")
		t.eq(N.normalize("salt & pepper"), "salt and pepper")
		t.eq(N.normalize("ice_cream"), "ice cream")
		t.eq(N.normalize("\tfire\nball\0"), "fire ball")
		t.eq(N.normalize(nil :: any), "")
	end)

	t.test("keeps apostrophes and hyphens only inside words", function()
		t.eq(N.normalize("jack-o'-lantern"), "jack-o'-lantern")
		t.eq(N.normalize("T-Rex"), "t-rex")
		t.eq(N.normalize("'dragon'"), "dragon")
		t.eq(N.normalize("--sword--"), "sword")
		t.eq(N.normalize("dragon’s breath"), "dragon's breath")
		t.eq(N.normalize("fire -- ball"), "fire ball")
	end)

	t.test("leetspeak inside words, real numbers untouched", function()
		t.eq(N.normalize("dr4gon"), "dragon")
		t.eq(N.normalize("f1re"), "fire")
		t.eq(N.normalize("h3ll0 k1tty"), "hello kitty")
		t.eq(N.normalize("$hark"), "shark")
		t.eq(N.normalize("l@ser"), "laser")
		t.eq(N.normalize("100"), "100")
		t.eq(N.normalize("100 bees"), "100 bees")
		t.eq(N.normalize("r2d2"), "r2d2")
		t.eq(N.normalize("4x4"), "4x4")
		t.eq(N.normalize("1000"), "1000")
	end)

	t.test("number words", function()
		t.eq(N.normalize("2 headed dragon"), "two headed dragon")
		t.eq(N.normalize("two headed dragon"), "two headed dragon")
		t.eq(N.normalize("2-headed dragon"), "two-headed dragon")
		t.eq(N.normalize("3headed dog"), "three headed dog")
		t.eq(N.normalize("21 sharks"), "21 sharks")
		t.eq(N.toNumber("seven"), 7)
		t.eq(N.toNumber("100"), 100)
		t.eq(N.toNumber("dragon"), nil)
	end)

	t.test("repeated letters collapse to 2, variants try 1", function()
		t.eq(N.normalize("fiiiire"), "fiire")
		t.eq(N.collapseRepeats("fiire", 1), "fire")
		t.eq(N.normalize("balloooon"), "balloon")
		local v = N.variants("fiiiire")
		t.ok(table.find(v, "fire") ~= nil, "variants include fire")
		t.eq(N.normalize("1000000"), "1000000")
	end)

	t.test("variants include alt leet and light form", function()
		local v = N.variants("1aser")
		t.ok(table.find(v, "laser") ~= nil, "1 -> l reading")
		local w = N.variants("mp3 player")
		t.ok(table.find(w, "mp3 player") ~= nil, "light form keeps digits")
	end)

	t.test("tokenize", function()
		local toks = N.tokenize("  Army of GIANT dr4gons! ")
		t.eq(#toks, 4)
		t.eq(toks[4], "dragons")
		t.eq(#N.tokenize("   "), 0)
	end)

	t.test("spacing variants", function()
		local v = N.spacingVariants("t-rex")
		t.ok(table.find(v, "t rex") and table.find(v, "trex"), "t-rex variants")
		local w = N.spacingVariants("fire dragon")
		t.ok(table.find(w, "firedragon") ~= nil, "joined")
	end)

	t.test("invalid utf8 and very long input are safe", function()
		t.eq(N.normalize("dra\255\254gon"), "dra gon")
		local long = string.rep("a", 5000)
		t.ok(#N.normalize(long) <= 200)
	end)
end
